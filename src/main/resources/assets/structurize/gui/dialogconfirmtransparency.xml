<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    pause="true" lightbox="true">
    <image id="qcShell" source="structurize:textures/gui/quidcraft/window_200x220.png" pos="0 0" size="200 220"/>
    <image id="qcHeader" source="structurize:textures/gui/quidcraft/header_184x22.png" pos="8 6" size="184 22"/>

    <view id="root_pos" pos="70 0" size="177 150" align="MIDDLE">
        <text pos="10 8" size="157 105" color="#ECE8E0" textalign="TOP_MIDDLE" text="$(structurize.config.transparency.warning)"/>
        <button id="confirm" pos="10 123" size="64 17" color="#ECE8E0" textalign="MIDDLE" textbox="64 17" text="$(gui.yes)" source="structurize:textures/gui/builderhut/builder_button_small.png" textcolor="#ECE8E0"/>
        <button id="cancel" pos="103 123" size="64 17" color="#ECE8E0" textalign="MIDDLE" textbox="64 17" text="$(gui.cancel)" source="structurize:textures/gui/builderhut/builder_button_small.png" textcolor="#ECE8E0"/>
    </view>
</window>