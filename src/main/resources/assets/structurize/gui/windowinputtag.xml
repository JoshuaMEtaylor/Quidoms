<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="400 244" pause="true" lightbox="true">
    <!-- qd148:quidcraft-restyle -->
    <image id="qcShell" source="structurize:textures/gui/quidcraft/window_400x244.png" pos="0 0" size="400 244"/>
    <image id="qcHeader" source="structurize:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="384 24"/>
    <image id="qcContent" source="structurize:textures/gui/quidcraft/content_400x200.png" pos="8 36" size="384 190"/>

    <text size="360 14" pos="20 48" textalign="MIDDLE" color="#ECE8E0" textcolor="#ECE8E0"
          label="$(com.ldtteam.structurize.gui.placeholder.inputtag)"/>
    <input id="name" size="280 18" pos="60 90" maxlength="50" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="done" size="129 17" pos="70 150" label="$(gui.done)" color="#ECE8E0" textcolor="#ECE8E0"
            source="structurize:textures/gui/quidcraft/btn_129x17.png"/>
    <button id="cancel" size="129 17" pos="210 150" label="$(gui.cancel)" color="#ECE8E0" textcolor="#ECE8E0"
            source="structurize:textures/gui/quidcraft/btn_129x17.png"/>
</window>
