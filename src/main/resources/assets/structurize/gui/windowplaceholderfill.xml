<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="420 240" pause="false" lightbox="false">
    <!-- qd148:quidcraft-restyle -->
    <image id="qcShell" source="structurize:textures/gui/quidcraft/window_420x240.png" pos="0 0" size="420 240"/>
    <image id="qcHeader" source="structurize:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="404 24"/>


    <box size="100% 100%" linewidth="1">
        <text size="50 11" pos="1 3" color="#ECE8E0" label="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.ystretch)" textcolor="#ECE8E0"/>
        <input id="ystretch" textContent="1" size="36 11" pos="55 3" tooltip="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.ystretch.tooltip)"  maxlength="10" color="#ECE8E0" textcolor="#ECE8E0"/>
        <text size="50 11" pos="1 19" color="#ECE8E0" label="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.radius)" textcolor="#ECE8E0"/>
        <input id="radius" textContent="1" size="36 11" pos="55 19" tooltip="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.radius.tooltip)"  maxlength="10" color="#ECE8E0" textcolor="#ECE8E0"/>
        <text size="50 11" pos="1 37" color="#ECE8E0" label="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.heightoffset)" textcolor="#ECE8E0"/>
        <input id="heightoffset" textContent="0" size="36 11" pos="55 37" tooltip="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.heightoffset.tooltip)"  maxlength="10" color="#ECE8E0" textcolor="#ECE8E0"/>
        <text size="50 11" pos="1 53" color="#ECE8E0" label="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.blockdist)" textcolor="#ECE8E0"/>
        <input id="blockdist" textContent="2" size="36 11" pos="55 53" tooltip="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.blockdist.tooltip)"  maxlength="10" color="#ECE8E0" textcolor="#ECE8E0"/>

        <button label="$(com.ldtteam.structurize.gui.scantool.fillplacerholder.apply)" id="fill" pos="15 70" size="40 17" source="structurize:textures/gui/quidcraft/btn_129x17.png" textcolor="#ECE8E0"/>
        <button label="X" id="cancelfill" pos="70 70" size="17 17" source="structurize:textures/gui/quidcraft/btn_129x17.png" textcolor="#ECE8E0"/>
    </box>

</window>
