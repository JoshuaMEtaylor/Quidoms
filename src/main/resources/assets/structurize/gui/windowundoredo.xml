<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="420 240" type="VANILLA" pause="false" lightbox="false">
    <!-- qd148:quidcraft-restyle -->
    <image id="qcShell" source="structurize:textures/gui/quidcraft/window_420x240.png" pos="0 0" size="420 240"/>
    <image id="qcHeader" source="structurize:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="404 24"/>


    <text id="textcontent" size="150 30" pos="120 40" textalign="TOP_MIDDLE" color="#ECE8E0" wrap="true" text="$(structurize.gui.undoredo.desc)" textcolor="#ECE8E0"/>
    <button id="cancel" source="structurize:textures/gui/buildtool/cancel.png" size="32" pos="270 40" color="#ECE8E0" textcolor="#ECE8E0"/>

    <list id="operations" size="350 120" pos="50 70" visible="true">
        <box size="100% 15" linewidth="1" visible="true">
            <text id="operationname" size="260 16" textalign="MIDDLE_LEFT" pos="5 1" color="#ECE8E0" wrap="true" textcolor="#ECE8E0"/>
            <button id="undo" source="structurize:textures/gui/buildtool/rotateleftsmall.png" visible="true" size="32 16" pos="270 1" textcolor="#ECE8E0" texthovercolor="#ECE8E0" tooltip="$(structurize.gui.undoredo.undoop)"/>
            <button id="redo" source="structurize:textures/gui/buildtool/rotaterightsmall.png" visible="true" size="32 16" pos="305 1" textcolor="#ECE8E0" texthovercolor="#ECE8E0" tooltip="$(structurize.gui.undoredo.redoop)"/>
        </box>
    </list>
</window>