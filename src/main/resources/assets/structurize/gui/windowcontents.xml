        <box size="100% 20" linewidth="1">
            <itemicon id="icon" size="16 16" pos="1 2"/>
            <text id="registry_key" size="110 9" pos="20 1" wrap="true" color="#ECE8E0" textcolor="#ECE8E0"/>
            <text id="amount" size="110 9" pos="20 11" color="#ECE8E0" textcolor="#ECE8E0"/>
        </box>
    </list>
    <text size="140 12" pos="165 8" color="#ECE8E0" textcolor="#ECE8E0" text="$(structurize.gui.content.blocks_content)"/>
    <list id="block_item_handlers" size="145 450" pos="165 24" childspacing="-1">
