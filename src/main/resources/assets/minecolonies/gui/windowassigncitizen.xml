<window size="400 244" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <!-- qd148:quidcraft-restyle -->
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_400x244.png" pos="0 0" size="400 244"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="384 24"/>


    <text size="100% 11" pos="0 20" textalign="MIDDLE" color="#ECE8E0" label="$(com.minecolonies.coremod.gui.assigning.description)" textcolor="#ECE8E0"/>

    <list id="assigned" size="190 160" pos="10 40">
        <view size="100% 34">
            <gradient gradientstart="430265344" gradientend="430265344" size="100% 100%"/>
            <text id="citizen" size="100% 12" pos="5 2" color="blue" textcolor="#ECE8E0"/>
            <button id="fire" size="44 10" pos="120 2" color="#ECE8E0" source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png" label="$(com.minecolonies.coremod.gui.hiring.buttonfire)" textscale="0.8" textcolor="#ECE8E0"/>

            <text id="job" size="175 20" pos="5 13" color="#ECE8E0" textalign="TOP_LEFT" textcolor="#ECE8E0"/>
        </view>
    </list>

    <list id="unassigned" size="190 160" pos="201 40">
        <view size="100% 34">
            <gradient gradientstart="430265344" gradientend="430265344" size="100% 100%"/>
            <text id="citizen" size="100% 12" pos="5 2" color="blue" textcolor="#ECE8E0"/>
            <button id="hire" size="44 10" pos="120 2" color="#ECE8E0" source="minecolonies:textures/gui/builderhut/builder_button_quite_small.png" label="$(com.minecolonies.coremod.gui.hiring.buttonassign)" textscale="0.8" textcolor="#ECE8E0"/>

            <text id="job" size="175 20" pos="5 13" color="#ECE8E0" textscale="0.8" textcolor="#ECE8E0"/>
        </view>
    </list>

    <text id="buildingassignmentmode" size="200 11" pos="40 210" color="#ECE8E0" label="$(com.minecolonies.coremod.gui.buildingassignmentmode)" textcolor="#ECE8E0"/>
    <button id="mode" size="169 17" pos="170 207" color="#ECE8E0" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" textcolor="#ECE8E0"/>

    <button id="cancel" size="14 15" pos="375 10" source="minecolonies:textures/gui/button_x.png" color="#ECE8E0" textcolor="#ECE8E0"/>
</window>
