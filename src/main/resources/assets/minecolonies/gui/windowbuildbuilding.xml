<window size="420 240" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        lightbox="true">

    <!-- Centered header: style pack switcher + builder picker + close -->
    <button id="previousStyle" size="14 15" pos="46 8" label="&lt;"
                 source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black"/>
    <dropdown id="style"
              size="129 17"
              pos="62 7"
              maxContentHeight="75"
              dropDownSize="140 75"
              source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
              color="black">
        <view size="100% 15">
            <text id="id" size="100% 100%" label="" pos="0 0"/>
            <button id="button" size="129 17" pos="0 0"
                         source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" color="black"/>
        </view>
    </dropdown>
    <button id="nextStyle" size="14 15" pos="193 8" label="&gt;"
                 source="minecolonies:textures/gui/builderhut/builder_button_mini.png" color="black"/>

    <dropdown id="worker"
              size="129 17"
              pos="220 7"
              maxContentHeight="75"
              dropDownSize="140 75"
              source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
              color="black">
        <view size="100% 15">
            <text id="id" size="100% 100%" label="" pos="0 0"/>
            <button id="button" size="129 17" pos="0 0"
                         source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" color="black"/>
        </view>
    </dropdown>

    <button id="cancel" size="14 15" pos="390 8"
                 source="minecolonies:textures/gui/button_x.png" color="black"/>

    <!-- Fixed resource list: fills the middle band, name width leaves room for qty -->
    <list id="resources" size="360 168" pos="30 30">
        <box size="100% 30" linewidth="1">
            <itemicon id="resourceIcon" size="24 24" pos="3 3"/>
            <text id="resourceName" size="280 12" pos="33 9" color="white"/>
            <text id="resourceQuantity" size="36 12" pos="318 9" color="white" textalign="MIDDLE_RIGHT"/>
        </box>
    </list>

    <!-- Footer actions anchored to bottom of 420x240 -->
    <button id="repair" size="129 17" pos="16 214"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.repair)" color="black"/>
    <button id="build" size="129 17" pos="145 214"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.upgrade)" color="black"/>
    <button id="deconstruct" size="129 17" pos="274 214"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.deconstruct)" color="black"/>
    <button id="pickup" size="129 17" pos="274 214"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.pickup)" color="black" visible="false"/>
</window>
