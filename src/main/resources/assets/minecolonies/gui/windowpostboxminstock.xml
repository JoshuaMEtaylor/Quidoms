            <itemicon id="resourceIcon" size="17 17" pos="0 0"/>
            <text id="resourceName" size="90 12" pos="20 1" color="#ECE8E0"/>
            <text id="resourceQty" size="12 12" pos="115 1" color="#ECE8E0"/>

            <button label="X" id="removeStock" pos="130 1" size="29 15" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="red" textcolor="#ECE8E0"/>
        </box>
    </list>

    <button id="addStock" size="86 17" pos="177 30" color="#ECE8E0" source="minecolonies:textures/gui/quidcraft/btn_86x17.png" label="$(com.minecolonies.coremod.gui.warehouse.add)" textcolor="#ECE8E0"/>
</window>

