<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="400 244"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/1.20.1/src/main/resources/assets/blockui/gui/block_ui.xsd"
>
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_400x244.png" pos="0 0" size="400 244"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="384 24"/>


    <text size="440 13" pos="0 14" color="#ECE8E0" textalign="MIDDLE" label="$(com.minecolonies.coremod.gui.warehouse.stock)"/>

    <list id="resourcesstock" size="170 180" pos="135 50" emptytext="$(com.minecolonies.coremod.gui.warehouse.stock.empty)" emptycolor="#ECE8E0">
