<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="420 260"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_420x260.png" pos="0 0" size="420 260"/>
    <image id="qcSidebar" source="minecolonies:textures/gui/quidcraft/sidebar_96x260.png" pos="0 0" size="96 260"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_288x24.png" pos="104 8" size="288 24"/>
    <image id="qcContent" source="minecolonies:textures/gui/quidcraft/content_288x200.png" pos="104 36" size="288 200"/>

    <image source="minecolonies:textures/gui/builderhut/builder_charcoal_chalk.png" size="19 59" pos="175 180"/>

    <image source="minecolonies:textures/gui/builderhut/builder_sketch_left.png" size="6 15" pos="44 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_center.png" size="90 15" pos="50 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_right.png" size="6 15" pos="140 12"/>
    <text id="constructionName" size="90 11" pos="50 14" textalign="MIDDLE" color="blue"/>

    <text id="loading" size="90 11" pos="50 116" textalign="MIDDLE" color="green"
           label="$(com.minecolonies.command.gui.browsebuilding.loading)" />
    <image id="progress" size="0 16" pos="50 130" source="minecolonies:progress_block"/>

    <list id="buildings" size="162 80%" pos="15 30" visible="false">
        <box size="100% 32" linewidth="1">
            <text id="packName" size="158 10" pos="2 2" color="#ECE8E0"/>
            <text id="buildingName" size="158 10" pos="2 11" color="#ECE8E0" textscale="0.5" wrap="true"/>
            <text id="buildingSize" size="69% 10" pos="2 21" color="#ECE8E0"/>
            <text id="buildingLevel" align="TOP_RIGHT" textalign="TOP_RIGHT" size="29% 10" pos="2 21" color="#ECE8E0"/>
        </box>
    </list>
</window>
