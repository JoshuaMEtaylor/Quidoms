<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="380 255">
    <layout source="minecolonies:gui/layouthuts/layouthutshell.xml"/>
    <text id="title" size="130 11" pos="128 42" textalign="MIDDLE" color="#ECE8E0" label="$(com.minecolonies.core.menu.title)"/>
    <text id="warning" size="150 22" pos="13 50" color="#ECE8E0" textalign="MIDDLE" label="$(com.minecolonies.core.menu.warning)"/>
    <text id="poorwarning" size="160 22" pos="14 25" color="red" textalign="MIDDLE" label="$(com.minecolonies.core.poor.menu.warning)" visible="false"/>

    <list id="resourcesstock" size="164 90" pos="13 45">
        <box size="100% 17" linewidth="1">
            <gradient id="gradient" size="162 15" pos="1 1"/>
            <itemicon id="resourceIcon" size="16 16" pos="0 0"/>
            <text id="resourceName" size="100 12" pos="20 1" color="#ECE8E0"/>

            <button label="X" id="removeStock" pos="126 1" size="29 15"
                    source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" textcolor="red"/>
        </box>
    </list>

    <text id="ingredients" size="130 11" pos="13 135" textalign="MIDDLE" color="#ECE8E0"
          label="$(com.minecolonies.core.menu.ingredients)"/>
    <list id="ingredientslist" size="164 85" pos="13 145">
        <box size="100% 17" linewidth="1">
            <itemicon id="resourceIcon" size="16 16" pos="0 0"/>
            <text id="resourceName" size="100 12" pos="20 1" color="#ECE8E0"/>
        </box>
    </list>

    <text id="desc" size="130 11" pos="240 42" color="#ECE8E0" textalign="MIDDLE" label="$(com.minecolonies.core.food_list.title)"/>
    <input id="input" size="150 18" pos="230 56" maxlength="25" color="#ECE8E0"/>

    <list id="resources" size="164 180" pos="223 78">
        <box size="100% 17" linewidth="1">
            <gradient id="gradient" size="162 15" pos="1 1"/>
            <itemicon id="resourceIcon" size="16 16" pos="20 0"/>
            <text id="resourceName" size="100 12" pos="40 3" color="#ECE8E0"/>
            <button label="&lt;&lt;" id="switch" pos="3 1" size="14 15"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" textcolor="#ECE8E0"/>
        </box>
    </list>
</window>
