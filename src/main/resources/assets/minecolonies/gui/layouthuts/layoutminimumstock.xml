<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="420 260">
    <layout source="minecolonies:gui/layouthuts/layouthutshell.xml"/>

    <text size="200 11" pos="118 12" textalign="MIDDLE" color="#ECE8E0" textcolor="#ECE8E0"
           label="$(com.minecolonies.coremod.gui.warehouse.stock)"/>

    <button id="addStock" size="129 17" pos="118 48" color="#ECE8E0" textcolor="#ECE8E0"
                 source="minecolonies:textures/gui/quidcraft/btn_129x17.png"
                 label="$(com.minecolonies.coremod.gui.warehouse.add)"/>

    <list id="resourcesstock" size="270 150" pos="118 72"
          emptytext="$(com.minecolonies.coremod.gui.warehouse.stock.empty)" emptycolor="#ECE8E0">
        <box size="100% 17" linewidth="1">
            <itemicon id="resourceIcon" size="17 17" pos="0 0"/>
            <text id="resourceName" size="180 12" pos="20 1" color="#ECE8E0" textcolor="#ECE8E0"/>
            <text id="resourceQty" size="24 12" pos="210 1" color="#ECE8E0" textcolor="#ECE8E0"/>
            <button label="X" id="removeStock" pos="240 1" size="29 15"
                         source="minecolonies:textures/gui/builderhut/builder_button_very_small.png"
                         color="#ECE8E0" textcolor="#ECE8E0"/>
        </box>
    </list>
</window>
