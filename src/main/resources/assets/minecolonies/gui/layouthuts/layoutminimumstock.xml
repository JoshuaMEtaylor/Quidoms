<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="420 260">
    <layout source="minecolonies:gui/layouthuts/layouthutshell.xml"/>
            <text size="130 11" pos="30 14" textalign="MIDDLE" color="#ECE8E0"
                   label="$(com.minecolonies.coremod.gui.warehouse.stock)"/>
    <list id="resourcesstock" size="170 180" pos="13 50" emptytext="$(com.minecolonies.coremod.gui.warehouse.stock.empty)" emptycolor="#ECE8E0">
                <box size="100% 17" linewidth="1">
                    <itemicon id="resourceIcon" size="17 17" pos="0 0"/>
                    <text id="resourceName" size="90 12" pos="20 1" color="#ECE8E0"/>
                    <text id="resourceQty" size="12 12" pos="115 1" color="#ECE8E0"/>

                    <button label="X" id="removeStock" pos="130 1" size="29 15"
                                 source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="red" textcolor="#ECE8E0"/>
                </box>
            </list>
            <button id="addStock" size="86 17" pos="50 30" color="#ECE8E0"
                         source="minecolonies:textures/gui/quidcraft/btn_86x17.png"
                         label="$(com.minecolonies.coremod.gui.warehouse.add)" textcolor="#ECE8E0"/>
</window>
