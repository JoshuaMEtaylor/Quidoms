<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="420 260">
    <layout source="minecolonies:gui/layouthuts/layouthutshell.xml"/>
    <text size="130 11" pos="128 42" textalign="MIDDLE" color="#ECE8E0"
           label="$(com.minecolonies.coremod.gui.docrafting)"/>

    <list id="resources" size="135 57" pos="118 63">
        <view size="100% 17">
            <text id="resourceName" size="40 12" pos="0 2" color="#ECE8E0"/>
            <itemicon id="resourceIcon" size="17 17" pos="40 0"/>
            <button id="resourceAdd" size="64 15" pos="60 0" color="#ECE8E0" source="minecolonies:textures/gui/builderhut/builder_button_small.png" label="$(com.minecolonies.coremod.gui.docrafting.switch)" textcolor="#ECE8E0"/>
        </view>
    </list>

    <button id="request" size="16 16" pos="253 79" source="minecolonies:textures/gui/citizen/detail_button.png" tooltip="$(com.minecolonies.coremod.gui.citizen.requesttitle)" color="#ECE8E0" textcolor="#ECE8E0"/>

    <list id="resourcesstock" size="170 100" pos="118 100">
        <box size="100% 17" linewidth="1">
            <itemicon id="resourceIcon" size="17 17" pos="0 0"/>
            <text id="resourceName" size="90 12" pos="20 1" color="#ECE8E0"/>
            <text id="resourceQty" size="12 12" pos="115 1" color="#ECE8E0"/>
        </box>
    </list>

    <button id="add" size="64 17" pos="158 238" color="#ECE8E0" source="minecolonies:textures/gui/builderhut/builder_button_small.png" label="$(com.minecolonies.coremod.gui.docrafting.teach)" textcolor="#ECE8E0"/>
</window>
