            <itemicon id="resourceIcon" size="16 16" pos="0 0"/>
            <text id="resourceName" size="100 12" pos="20 1" color="#ECE8E0"/>
            <button label="$(com.minecolonies.coremod.gui.workerhuts.retrieveOn)" id="switch" pos="120 1" size="29 15"
                         source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" color="#ECE8E0" textcolor="#ECE8E0"/>
        </box>
    </list>
    <button label ="$(com.minecolonies.coremod.gui.workerhuts.resetdefault)" id="resetDefault" size="86 17" pos="148 222"
                 source="minecolonies:textures/gui/quidcraft/btn_86x17.png" color="#ECE8E0" textcolor="#ECE8E0"/>
</window>
