<window size="420 260" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_420x260.png" pos="0 0" size="420 260"/>
    <image id="qcSidebar" source="minecolonies:textures/gui/quidcraft/sidebar_96x260.png" pos="0 0" size="96 260"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_288x24.png" pos="104 8" size="288 24"/>
    <image id="qcContent" source="minecolonies:textures/gui/quidcraft/content_288x200.png" pos="104 36" size="288 200"/>

    <image source="minecolonies:textures/gui/builderhut/builder_sketch_left.png" size="6 15" pos="34 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_center.png" size="110 15" pos="40 12"/>
    <image source="minecolonies:textures/gui/builderhut/builder_sketch_right.png" size="6 15" pos="150 12"/>

    <text size="100% 11" pos="0 14" color="#ECE8E0" textalign="MIDDLE"
           label="$(com.minecolonies.coremod.item.questlog.gui.title)"/>

    <button id="prevPage" size="18 10" pos="13 13" source="minecolonies:textures/gui/builderhut/turn_page_left.png" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="nextPage" size="18 10" pos="159 13" source="minecolonies:textures/gui/builderhut/turn_page_right.png" color="#ECE8E0" textcolor="#ECE8E0"/>

    <switch id="pages" size="160 203" pos="15 30" endless="true">
        <view id="pageInProgress">
            <text size="100% 11" pos="0 0" color="#ECE8E0" textalign="MIDDLE"
                   label="$(com.minecolonies.coremod.item.questlog.gui.inprogress)"/>

            <list id="quests" size="160 187" pos="0 15">
                <view size="100% 45">
                    <text id="questName" size="130 11" pos="0 0" color="#ECE8E0"/>
                    <text id="questGiver" size="130 11" pos="0 15" color="#ECE8E0"/>
                    <text id="questObjective" size="130 11" pos="0 30" color="#ECE8E0"/>
                    <button id="questLocator" size="15 22" pos="135 0" source="minecolonies:textures/gui/quest-locator.png" color="#ECE8E0" textcolor="#ECE8E0"/>
                </view>
            </list>
        </view>
        <view id="pageAvailable">
            <text size="100% 11" pos="0 0" color="#ECE8E0" textalign="MIDDLE"
                   label="$(com.minecolonies.coremod.item.questlog.gui.available)"/>

            <list id="quests" size="160 187" pos="0 15">
                <view size="100% 30">
                    <text id="questName" size="130 11" pos="0 0" color="#ECE8E0"/>
                    <text id="questGiver" size="130 11" pos="0 15" color="#ECE8E0"/>
                    <button id="questLocator" size="15 22" pos="135 0" source="minecolonies:textures/gui/quest-locator.png" color="#ECE8E0" textcolor="#ECE8E0"/>
                </view>
            </list>
        </view>
        <view id="pageFinished">
            <text size="100% 11" pos="0 0" color="#ECE8E0" textalign="MIDDLE"
                   label="$(com.minecolonies.coremod.item.questlog.gui.finished)"/>

            <list id="quests" size="160 187" pos="0 15">
                <view size="100% 30">
                    <text id="questName" size="130 11" pos="0 0" color="#ECE8E0"/>
                    <text id="questCompletedCount" size="130 11" pos="0 15" color="#ECE8E0"/>
                </view>
            </list>
        </view>
    </switch>
</window>
