<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="400 244" pause="false" lightbox="false">
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_400x244.png" pos="0 0" size="400 244"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="384 24"/>

    <text id="desc" size="130 11" pos="30 14" color="#ECE8E0" textalign="MIDDLE"/>
    <input id="input" size="150 18" pos="20 30" maxlength="25" color="#ECE8E0"/>

    <list id="resources" size="164 136" pos="13 50">
        <box size="100% 17" linewidth="1">
            <gradient id="gradient" size="162 15" pos="1 1"/>
            <itemicon id="resourceIcon" size="16 16" pos="1 0"/>
            <text id="resourceName" size="100 12" pos="20 3" color="#ECE8E0"/>
            <button label="$(com.minecolonies.coremod.gui.workerhuts.retrieveOn)" id="switch" pos="120 1" size="29 15" source="minecolonies:textures/gui/builderhut/builder_button_very_small.png" textcolor="#ECE8E0"/>
        </box>
    </list>
    <button label="$(com.minecolonies.coremod.gui.workerhuts.resetdefault)" id="resetDefault" size="86 17" pos="50 194" source="minecolonies:textures/gui/quidcraft/btn_86x17.png" textcolor="#ECE8E0"/>
</window>
