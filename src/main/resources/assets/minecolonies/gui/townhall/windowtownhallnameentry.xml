<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        lightbox="true"
        type="OVERSIZED_VANILLA">
    <text size="100% 11" pos="0 100" textalign="TOP_MIDDLE" color="white"
           label="$(com.minecolonies.coremod.gui.townhall.rename.title)"/>
    <input id="name" size="150 18" pos="135 110" maxlength="25" color="white"/>
    <button id="done" size="200 20" pos="110 170" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
            label="$(gui.done)"/>
    <button id="cancel" size="200 20" pos="110 194" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
            label="$(gui.cancel)"/>
</window>
