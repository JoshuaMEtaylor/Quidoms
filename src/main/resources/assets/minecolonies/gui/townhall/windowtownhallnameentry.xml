<window size="400 244" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        lightbox="true"
        type="OVERSIZED_VANILLA">
    <!-- qd148:quidcraft-restyle -->
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_400x244.png" pos="0 0" size="400 244"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="8 6" size="384 24"/>

    <text size="100% 11" pos="0 100" textalign="TOP_MIDDLE" color="#ECE8E0"
           label="$(com.minecolonies.coremod.gui.townhall.rename.title)"/>
    <input id="name" size="150 18" pos="135 110" maxlength="25" color="#ECE8E0"/>
    <button id="done" size="200 20" pos="110 170" color="#ECE8E0" source="minecolonies:textures/gui/quidcraft/btn_129x17.png" label="$(gui.done)" textcolor="#ECE8E0"/>
    <button id="cancel" size="200 20" pos="110 194" color="#ECE8E0" source="minecolonies:textures/gui/quidcraft/btn_129x17.png" label="$(gui.cancel)" textcolor="#ECE8E0"/>
</window>
