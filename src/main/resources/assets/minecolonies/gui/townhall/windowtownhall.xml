<window size="520 280"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">

    <!-- QuidCraft shell: single full-bleed background at 0,0 only -->
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_520x280.png" pos="0 0" size="520 280"/>

    <!-- Left sidebar strip -->
    <image id="qcSidebar" source="minecolonies:textures/gui/quidcraft/sidebar_96x280.png" pos="0 0" size="96 280"/>

    <!-- Content well -->
    <image id="qcContent" source="minecolonies:textures/gui/quidcraft/content_408x240.png" pos="104 32" size="408 240"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="104 4" size="408 24"/>

    <!-- Inactive tab markers (*0) — inside sidebar, under icons -->
    <image id="actions0" pos="6 40" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="infopage0" pos="6 66" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="permissions0" pos="6 92" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="citizens0" pos="6 118" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="happiness0" pos="6 144" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="alliances0" pos="6 170" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>
    <image id="settings0" pos="6 196" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22.png"/>

    <!-- Selected tab title chips (*1) — top of content, hidden until page selects -->
    <button id="actions1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.actions)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="infopage1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.information)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="permissions1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.permissions)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="citizens1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.citizens)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="happiness1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.stats)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="alliances1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.alliances)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>
    <button id="settings1" size="200 17" pos="112 8" source="minecolonies:textures/gui/quidcraft/btn_129x17_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.settings)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" textcolor="#F4F1EA" textdisabledcolor="#B7B1A8"/>

    <!-- Hover labels: INSIDE sidebar (never negative / off-window) -->
    <button id="actionsExt" pos="6 40" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.actions)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="infoExt" pos="6 66" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.information)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="permissionsExt" pos="6 92" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.permissions)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="citizensExt" pos="6 118" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.citizens)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="happinessExt" pos="6 144" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.stats)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="alliancesExt" pos="6 170" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.alliances)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>
    <button id="settingsExt" pos="6 196" size="84 22" source="minecolonies:textures/gui/quidcraft/nav_84x22_sel.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.settings)"
                 textalign="MIDDLE_LEFT" textcolor="#F4F1EA" textoffset="22 0"/>

    <!-- Nav icon buttons (wax seals) -->
    <button id="actions" size="17 17" pos="10 42" onHoverId="actionsExt"
                 source="minecolonies:textures/gui/red_wax_home.png"/>
    <button id="infopage" size="17 17" pos="10 68" onHoverId="infoExt"
                 source="minecolonies:textures/gui/red_wax_work_orders.png"/>
    <button id="permissions" size="17 17" pos="10 94" onHoverId="permissionsExt"
                 source="minecolonies:textures/gui/red_wax_permissions.png"/>
    <button id="citizens" size="17 17" pos="10 120" onHoverId="citizensExt"
                 source="minecolonies:textures/gui/red_wax_citizens.png"/>
    <button id="happiness" size="17 17" pos="10 146" onHoverId="happinessExt"
                 source="minecolonies:textures/gui/red_wax_stats.png"/>
    <button id="alliances" size="17 17" pos="10 172" onHoverId="alliancesExt"
                 source="minecolonies:textures/gui/red_wax_information.png"/>
    <button id="settings" size="17 17" pos="10 198" onHoverId="settingsExt"
                 source="minecolonies:textures/gui/red_wax_settings.png"/>
</window>
