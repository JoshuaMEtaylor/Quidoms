<window size="520 280"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <!-- qd148:quidcraft-restyle -->

    <!-- QuidCraft shell — single full-bleed at 0,0 -->
    <image id="qcShell" source="minecolonies:textures/gui/quidcraft/window_520x280.png" pos="0 0" size="520 280"/>
    <image id="qcSidebar" source="minecolonies:textures/gui/quidcraft/sidebar_96x280.png" pos="0 0" size="96 280"/>
    <image id="qcHeader" source="minecolonies:textures/gui/quidcraft/header_408x24.png" pos="104 4" size="408 24"/>
    <image id="qcContent" source="minecolonies:textures/gui/quidcraft/content_408x240.png" pos="104 32" size="408 240"/>

    <!-- *0 placeholders required by AbstractWindowTownHall.hide() — invisible -->
    <image id="actions0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="infopage0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="permissions0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="citizens0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="happiness0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="alliances0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>
    <image id="settings0" pos="0 0" size="1 1" source="minecolonies:textures/gui/quidcraft/nav_84x22.png" visible="false"/>

    <!-- Selected tab title in header (*1) -->
    <button id="actions1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.actions)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="infopage1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.information)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="permissions1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.permissions)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="citizens1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.citizens)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="happiness1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.stats)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="alliances1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.alliances)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>
    <button id="settings1" size="200 17" pos="112 7" source="minecolonies:textures/gui/quidcraft/btn_200x17.png" visible="false"
                 label="$(com.minecolonies.coremod.gui.townhalltab.settings)"
                 textalign="MIDDLE_LEFT" textoffset="8 0" color="#ECE8E0" textcolor="#ECE8E0" textdisabledcolor="#B7B1A8"/>

    <!-- Full-width sidebar nav: icon baked into texture + always-visible label; entire chip clickable -->
    <button id="actions" size="84 22" pos="6 40"
                 source="minecolonies:textures/gui/quidcraft/nav_actions.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.actions)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="infopage" size="84 22" pos="6 66"
                 source="minecolonies:textures/gui/quidcraft/nav_infopage.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.information)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="permissions" size="84 22" pos="6 92"
                 source="minecolonies:textures/gui/quidcraft/nav_permissions.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.permissions)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="citizens" size="84 22" pos="6 118"
                 source="minecolonies:textures/gui/quidcraft/nav_citizens.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.citizens)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="happiness" size="84 22" pos="6 144"
                 source="minecolonies:textures/gui/quidcraft/nav_happiness.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.stats)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="alliances" size="84 22" pos="6 170"
                 source="minecolonies:textures/gui/quidcraft/nav_alliances.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.alliances)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
    <button id="settings" size="84 22" pos="6 196"
                 source="minecolonies:textures/gui/quidcraft/nav_settings.png"
                 label="$(com.minecolonies.coremod.gui.townhalltab.settings)"
                 textalign="MIDDLE_LEFT" textoffset="22 0" color="#ECE8E0" textcolor="#ECE8E0"/>
</window>
