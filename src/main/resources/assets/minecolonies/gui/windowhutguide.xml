<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
        size="960 540" type="FULLSCREEN_VANILLA" lightbox="true"
        >

    <image source="minecolonies:textures/gui/guide/background.png" size="960 540" id="guide1"/>
    <!-- Vanilla AbstractButton sprites resolve as magenta via BlockUI Image.resolveBlit;
         use the packaged guide button tile instead (stretched to vanilla 200×20). -->
    <button id="confirm" size="200 20" pos="380 455"
                 source="minecolonies:textures/gui/guide/button.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.guide.confirm)"
                 color="white"/>
    <text id="questionmark" size="210 75" color="black" pos="80 363" textalign="MIDDLE" text="$(com.minecolonies.coremod.gui.workerhuts.guide.questionmark)"/>
    <text id="arrow" size="210 75" color="black" pos="637 22" textalign="MIDDLE" text="$(com.minecolonies.coremod.gui.workerhuts.guide.arrow)"/>
    <text id="chest" size="210 75" color="black" pos="646 363" textalign="MIDDLE" text="$(com.minecolonies.coremod.gui.workerhuts.guide.chest)"/>
</window>
